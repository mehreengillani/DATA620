    "action_data = pd.read_csv(\"act-mooc/mooc_actions.tsv\", sep=\"\\t\", header=0,\n",
    "                           names=[\"actionid\", \"userid\", \"targetid\", \"timestamp\"])\n",
    "action_labels = pd.read_csv(\"act-mooc/mooc_action_labels.tsv\", sep=\"\\t\", header=0,\n",
    "                             names=[\"actionid\", \"label\"])\n",
    "action_features = pd.read_csv(\"act-mooc/mooc_action_features.tsv\", sep=\"\\t\", header=0,\n",
    "                               names=[\"actionid\", \"feature0\", \"feature1\", \"feature2\", \"feature3\"])\n",
    "\n",
    "# now that the stray header row is gone, lock in proper numeric dtypes\n",
    "action_data = action_data.astype({\"actionid\": int, \"userid\": int, \"targetid\": int, \"timestamp\": float})\n",
    "action_labels = action_labels.astype({\"actionid\": int, \"label\": int})\n",
    "action_features = action_features.astype({\"actionid\": int, \"feature0\": float,\n",
    "                                           \"feature1\": float, \"feature2\": float, \"feature3\": float})\n",
    "\n",
    "print(action_data.shape, action_labels.shape, action_features.shape)\n",
    "action_data.head(3)\n"
   ]
