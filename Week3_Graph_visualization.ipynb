   "source": [
    "degree_values = list(degrees.values())\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Histogram: how many nodes have each degree\n",
    "axes[0].hist(degree_values, bins=15, color=\"steelblue\", edgecolor=\"white\")\n",
    "axes[0].set_title(\"Degree Distribution (all nodes)\")\n",
    "axes[0].set_xlabel(\"Degree (number of connections)\")\n",
    "axes[0].set_ylabel(\"Number of nodes\")\n",
    "\n",
    "# Bar chart: the top 10 most-connected activities (targets)\n",
    "target_degrees = {n: d for n, d in degrees.items() if n.startswith(\"t_\")}\n",
    "top_targets = sorted(target_degrees.items(), key=lambda x: x[1], reverse=True)[:10]\n",
    "labels = [t[0] for t in top_targets]\n",
    "values = [t[1] for t in top_targets]\n",
    "\n",
    "axes[1].bar(labels, values, color=\"salmon\")\n",
    "axes[1].set_title(\"Top 10 Most-Used Course Activities\")\n",
    "axes[1].set_xlabel(\"Activity (target) ID\")\n",
    "axes[1].set_ylabel(\"Number of connected students\")\n",
    "axes[1].tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"degree_distribution.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eb8a8ce1",
